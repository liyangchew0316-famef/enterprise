rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read, write allowed
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: public read (for order tracking) and create/update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Spools (filament inventory) collection: public read, write allowed
    match /spools/{spoolId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom quotes collection
    match /custom_quotes/{quoteId} {
      allow read: if true;
      allow write: if true;
    }

    // Chili drawings & custom creations
    match /chili_drawings/{drawingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Users collection: user profiles, sign up records and VIP accounts
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Spin prizes collection (Daily Spin lucky wheel configuration)
    match /spin_prizes/{prizeId} {
      allow read: if true;
      allow write: if true;
    }

    // Spin records collection (User daily spin activity logs)
    match /spin_records/{recordId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
