{
  "entities": {
    "products": {
      "title": "products",
      "description": "3D printed products offered by CABAI ENTERPRISE",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "orders": {
      "title": "orders",
      "description": "Customer e-commerce orders and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "trackingNumber": { "type": "string" }
      },
      "required": ["id", "date", "customer", "items", "total", "status"]
    },
    "spools": {
      "title": "spools",
      "description": "Filament material spool inventory for 3D printers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "material": { "type": "string" },
        "colorName": { "type": "string" },
        "colorHex": { "type": "string" },
        "stockKg": { "type": "number" },
        "maxCapacityKg": { "type": "number" },
        "isLow": { "type": "boolean" }
      },
      "required": ["id", "name", "material", "stockKg"]
    },
    "chili_drawings": {
      "title": "chili_drawings",
      "description": "User created custom chili drawings and 3D print designs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "creatorName": { "type": "string" },
        "imageData": { "type": "string" },
        "material": { "type": "string" },
        "colorName": { "type": "string" },
        "colorHex": { "type": "string" },
        "scalePercent": { "type": "number" },
        "infillPercent": { "type": "number" },
        "estimatedPrice": { "type": "number" },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "title", "imageData", "createdAt"]
    },
    "users": {
      "title": "users",
      "description": "Registered user accounts, VIP members and maker profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "authProvider": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "spin_prizes": {
      "title": "spin_prizes",
      "description": "Daily lucky spin wheel prizes, labels, promo codes, and slice images",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "promoCode": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "icon": { "type": "string" },
        "image": { "type": "string" },
