        "color": { "type": "string" },
        "textColor": { "type": "string" }
      },
      "required": ["id", "label", "color"]
    },
    "spin_records": {
      "title": "spin_records",
      "description": "User daily spin events, winning vouchers, and timestamps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prizeId": { "type": "number" },
        "prizeLabel": { "type": "string" },
        "isWin": { "type": "boolean" },
